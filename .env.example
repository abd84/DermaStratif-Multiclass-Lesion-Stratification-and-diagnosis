# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production

# Optional: multimodal vision analysis (cloud API key)
VISION_API_KEY=your-vision-api-key-here

# Application
HOST=0.0.0.0
PORT=5000
MAX_CONTENT_LENGTH=52428800  # 50MB max file size

# Model Configuration
MODEL_PATH=./Saved Models/best_model1_lora.pth
DEVICE=auto  # auto, cpu, cuda, mps
